{
  "name": "human-atlas",
  "version": "0.2.0",
  "private": true,
  "description": "An interactive 3D anatomy explorer: 2,234 individually selectable BodyParts3D meshes, 15 anatomical systems, 3,432 named concepts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashemag/human-atlas.git"
  },
  "homepage": "https://human-atlas-seven.vercel.app",
  "keywords": [
    "anatomy",
    "3d",
    "three.js",
    "webgl",
    "bodyparts3d",
    "education",
    "visualization"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3016",
    "build": "vite build",
    "preview": "vite preview --port 3016",
    "check": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt app web components lib scripts vite.config.ts",
    "format:check": "oxfmt --check app web components lib scripts vite.config.ts",
    "test": "node --test scripts/*.test.mjs",
    "validate": "node scripts/validate-atlas.mjs",
    "verify": "npm run format:check && npm run lint && npm run check && npm test && npm run validate && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "three": "^0.159.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.159.0",
    "@vitejs/plugin-react": "6.0.2",
    "meshoptimizer": "^1.2.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
